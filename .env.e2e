# Playwright e2e: local-only mode (VITE_SYNC_URL empty => no sync server, SyncStatus "disabled").
# Clerk network is blocked in the tests, so a public placeholder key is enough — the app boots
# from the seeded cached identity (see e2e/fixtures.ts). No secrets here.
VITE_SYNC_URL=
# Well-formed key whose Frontend API host never resolves (fixtures block *.clerk.*): clerk-js is
# served same-origin but can't reach the FAPI, so useAuth().isLoaded stays false and the seeded
# cached identity drives the app.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_ZTJlLWxvY2FsLmNsZXJrLmFjY291bnRzLmRldiQ=
