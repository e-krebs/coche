{
  "name": "coche",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build && node scripts/gen-headers.ts",
    "build:e2e": "vite build --mode e2e && node scripts/gen-headers.ts --mode e2e",
    "build:e2e:sync": "vite build --mode e2e-sync && node scripts/gen-headers.ts --mode e2e-sync",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc -p src/server/tsconfig.json",
    "typecheck:e2e": "tsc -p e2e/local/tsconfig.json",
    "typecheck:e2e:sync": "tsc -p e2e/sync/tsconfig.json",
    "typecheck:node": "tsc -p scripts/tsconfig.json",
    "lint": "oxlint",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "fix": "oxlint --fix . && oxfmt .",
    "check:secrets": "node scripts/check-dist-secrets.ts",
    "check:csp": "node scripts/check-csp.ts",
    "check:links": "node scripts/check-links.ts",
    "icons": "node scripts/gen-icons.ts",
    "test": "vitest run --project client",
    "test:watch": "vitest",
    "test:worker": "vitest run --project server",
    "test:e2e": "playwright test",
    "test:e2e:sync": "playwright test --config playwright.config.sync.ts",
    "sync:dev": "wrangler dev",
    "sync:deploy": "wrangler deploy",
    "deploy:spa": "yarn check:csp && yarn check:secrets && wrangler pages deploy dist --project-name coche --branch main --force"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/e-krebs/coche.git"
  },
  "keywords": [
    "shopping-list",
    "local-first",
    "crdt",
    "tinybase",
    "cloudflare-workers",
    "durable-objects",
    "tanstack-router"
  ],
  "author": "Emmanuel Krebs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/e-krebs/coche/issues"
  },
  "homepage": "https://github.com/e-krebs/coche#readme",
  "description": "Per-user, local-first shopping list — TanStack Router SPA + TinyBase CRDT + Cloudflare Worker/Durable Object.",
  "dependencies": {
    "@clerk/backend": "^3.17.1",
    "@clerk/clerk-react": "5.61.3",
    "@clerk/localizations": "^4.16.0",
    "@clerk/themes": "2.4.57",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/roboto": "^5.3.0",
    "@tanstack/react-router": "^1.170.32",
    "fractional-indexing": "^4.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tinybase": "^9.7.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@clerk/clerk-js": "5",
    "@clerk/testing": "^2.2.10",
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^5.20260719.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.23",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.0.3",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.0.1",
    "eslint-plugin-readable-tailwind": "3.0.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "msw": "^2.15.0",
    "oxfmt": "0.59.0",
    "oxlint": "1.74.0",
    "oxlint-tsgolint": "7.0.2001",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  },
  "packageManager": "yarn@4.17.1",
  "engines": {
    "node": ">=24"
  }
}
